<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:CharSheet3.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:CharSheet3.Views"
  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
  x:Class="CharSheet3.Views.MainWindow"
  Icon="/Assets/avalonia-logo.ico"
  Title="5e Character Sheet Tool">
  <SplitView
    IsPaneOpen="True"
    OpenPaneLength="300"
    CompactPaneLength="48"
    DisplayMode="CompactInline">
    <SplitView.Pane>
      <StackPanel Orientation="Vertical" Spacing="5" Margin="5">
        <Button></Button>
        <ListBox>
          <ListBoxItem>Test</ListBoxItem>
          <ListBoxItem>Test</ListBoxItem>
          <ListBoxItem>Test</ListBoxItem>
          <ListBoxItem>Test</ListBoxItem>
        </ListBox>
      </StackPanel>
    </SplitView.Pane>
    <SplitView.Content>
      <views:CharacterSheetView DataContext="{Binding CharacterSheetViewModel}"/>
    </SplitView.Content>
  </SplitView>
  <!--<SplitView Margin="0,0,0,0">
    <SplitView.Pane>
      <views:ClassBuilderView DataContext="{Binding ClassBuilderViewModel}"/>
    </SplitView.Pane>
    <SplitView.Content>
      <views:CharacterSheetView DataContext="{Binding CharacterSheetViewModel}"/>
    </SplitView.Content>
   </SplitView>-->
</Window>
