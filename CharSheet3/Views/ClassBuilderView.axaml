<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
  x:Class="CharSheet3.Views.ClassBuilderView">
  <StackPanel Orientation="Vertical">
    <Border Classes="TopBar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
        <Button Content="New" Margin="5" Command="{Binding NewCharacterCommand}" Classes="TopBar"/>
        <Button Content="Save" Margin="5" Command="{Binding LoadCharacterDataCommand}" Classes="TopBar"/>
      </StackPanel>
    </Border>
    
  </StackPanel>
</UserControl>
